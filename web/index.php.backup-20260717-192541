if ($path === '/missions/new' && $method === 'POST') {
    verify_csrf();
    $user = require_user();
    $robotId = (int)($_POST['robot_id'] ?? 0);
    $pickupId = (int)($_POST['pickup_location_id'] ?? 0);
    $destinationId = (int)($_POST['destination_location_id'] ?? 0);
    $cargo = trim((string)($_POST['cargo_description'] ?? ''));
    $rfidIds = array_values(array_unique(array_filter(array_map('intval', (array)($_POST['rfid_ids'] ?? [])))));

    if (!in_array($robotId, assigned_robot_ids($user), true) || $pickupId <= 0 || $destinationId <= 0 || $pickupId === $destinationId || $cargo === '') {
        flash('danger', 'Проверьте робота, точки маршрута и описание груза.');
        redirect_to('/missions/new');
    }

    $baseId = (int)$pdo->query("SELECT id FROM locations WHERE kind='base' ORDER BY id LIMIT 1")->fetchColumn();
    if ($baseId <= 0) {
        flash('danger', 'Не настроена базовая точка робота.');
        redirect_to('/missions/new');
    }

    $pin = random_pin();
    $pdo->beginTransaction();
    try {
        $uid = uuid4();
        $stmt = $pdo->prepare('INSERT INTO missions (mission_uid,robot_id,operator_id,pickup_location_id,destination_location_id,base_location_id,cargo_description,status,pin_hash,pin_encrypted,created_at,updated_at) VALUES (?,?,?,?,?,?,?,"created",?,?,NOW(),NOW())');
        $stmt->execute([
            $uid,
            $robotId,
            (int)$user['id'],
            $pickupId,
            $destinationId,
            $baseId,
            $cargo,
            password_hash($pin, PASSWORD_DEFAULT),
            app_encrypt($pin),
        ]);
        $missionId = (int)$pdo->lastInsertId();
        if ($rfidIds) {
            $allowedStmt = $pdo->prepare('SELECT id FROM rfid_cards WHERE id=? AND is_active=1');
            $linkStmt = $pdo->prepare('INSERT IGNORE INTO mission_rfid (mission_id,rfid_card_id) VALUES (?,?)');
            foreach ($rfidIds as $cardId) {
                $allowedStmt->execute([$cardId]);
                if ($allowedStmt->fetchColumn()) {
                    $linkStmt->execute([$missionId, $cardId]);
                }
            }
        }
        $mission = mission_for_user($missionId, $user);
        create_command($mission, 'stage_mission', mission_package($mission));
        add_event($missionId, 'ORDER_CREATED', 'cloud', ['operator_id' => (int)$user['id']]);
        $pdo->commit();
        flash('success', 'Заказ создан. Edge заберёт его при следующей синхронизации.');
        redirect_to('/missions/' . $missionId);
    } catch (Throwable $e) {
        if ($pdo->inTransaction()) {
            $pdo->rollBack();
        }
        flash('danger', 'Не удалось создать заказ: ' . $e->getMessage());
        redirect_to('/missions/new');
    }
}

