if ($method === 'POST' && preg_match('#^/admin/requests/(\d+)/approve$#', $path, $match)) {
    verify_csrf();
    require_admin();
    $stmt = $pdo->prepare('SELECT * FROM access_requests WHERE id=?');
    $stmt->execute([(int)$match[1]]);
    $request = $stmt->fetch();
    if (!$request) { http_response_code(404); exit('Заявка не найдена.'); }
    $token = bin2hex(random_bytes(24));
    $stmt = $pdo->prepare('SELECT id FROM users WHERE email=?');
    $stmt->execute([strtolower((string)$request['email'])]);
    $existingId = (int)$stmt->fetchColumn();
    if ($existingId) {
        $pdo->prepare('UPDATE users SET full_name=?,role="operator",is_active=0,activation_token=? WHERE id=?')->execute([$request['full_name'],$token,$existingId]);
    } else {
        $pdo->prepare('INSERT INTO users (email,full_name,password_hash,role,is_active,activation_token,created_at) VALUES (?,?,?,"operator",0,?,NOW())')->execute([
            strtolower((string)$request['email']),
            $request['full_name'],
            password_hash(bin2hex(random_bytes(24)), PASSWORD_DEFAULT),
            $token,
        ]);
    }
    $pdo->prepare('UPDATE access_requests SET status="approved",reviewed_at=NOW() WHERE id=?')->execute([(int)$request['id']]);
    flash('success', 'Заявка одобрена. Ссылка активации доступна в разделе «Пользователи».');
    redirect_to('/admin/requests');
}

