// API синхронизации локального сервера. Совместим с edge/main.py из MVP.
if ($path === '/api/edge/sync' && $method === 'POST') {
    $payload = read_json_body();
    $token = bearer_token();
    $edgeId = trim((string)($payload['edge_id'] ?? ''));

    if ($token === '' || $edgeId === '') {
        json_response(['detail' => 'Требуются Edge ID и Bearer-токен'], 401);
    }

    $stmt = $pdo->prepare('SELECT * FROM edge_gateways WHERE edge_id=?');
    $stmt->execute([$edgeId]);
    $edge = $stmt->fetch();
    if (!$edge || !password_verify($token, (string)$edge['token_hash'])) {
        json_response(['detail' => 'Неверный Edge ID или токен'], 403);
    }

    $pdo->beginTransaction();
    try {
        $pdo->prepare('UPDATE edge_gateways SET last_seen_at=NOW() WHERE id=?')->execute([(int)$edge['id']]);
        $acked = [];

        foreach (($payload['events'] ?? []) as $event) {
            if (!is_array($event)) {
                continue;
            }
            $missionUid = trim((string)($event['mission_id'] ?? ''));
            $eventUid = trim((string)($event['event_id'] ?? ''));
            $eventType = trim((string)($event['event_type'] ?? ''));
            if ($missionUid === '' || $eventUid === '' || $eventType === '') {
                continue;
            }

            $stmt = $pdo->prepare(
                'SELECT m.*, r.edge_gateway_id FROM missions m JOIN robots r ON r.id=m.robot_id '
                . 'WHERE m.mission_uid=? AND r.edge_gateway_id=?'
            );
            $stmt->execute([$missionUid, (int)$edge['id']]);
            $mission = $stmt->fetch();
            if (!$mission) {
                continue;
            }

            $payloadData = is_array($event['payload'] ?? null) ? $event['payload'] : [];
            $inserted = add_event(
                (int)$mission['id'],
                strtoupper($eventType),
                'edge',
                $payloadData,
                $eventUid,
                isset($event['occurred_at']) ? (string)$event['occurred_at'] : null
            );
            if ($inserted) {
                apply_edge_event($mission, $event);
            }
            $acked[] = $eventUid;
        }

        $stmt = $pdo->prepare(
            'SELECT c.*, m.mission_uid FROM edge_commands c '
            . 'LEFT JOIN missions m ON m.id=c.mission_id '
            . 'WHERE c.edge_gateway_id=? AND c.status="pending" ORDER BY c.id LIMIT 50'
        );
        $stmt->execute([(int)$edge['id']]);
        $commands = [];
        foreach ($stmt->fetchAll() as $command) {
            $commands[] = [
                'command_id' => $command['command_uid'],
                'type' => $command['command_type'],
                'mission_id' => $command['mission_uid'],
                'created_at' => date(DATE_ATOM, strtotime((string)$command['created_at'])),
                'payload' => json_decode((string)$command['payload_json'], true) ?: [],
            ];
        }

        $pdo->commit();
        json_response([
            'schema_version' => '1.0',
            'server_time' => date(DATE_ATOM),
            'acked_event_ids' => array_values(array_unique($acked)),
            'commands' => $commands,
        ]);
    } catch (Throwable $e) {
        if ($pdo->inTransaction()) {
            $pdo->rollBack();
        }
        json_response(['detail' => 'Ошибка синхронизации', 'error' => $e->getMessage()], 500);
    }
}

