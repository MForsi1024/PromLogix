if ($method === 'POST' && preg_match('#^/missions/(\d+)/confirm-loaded$#', $path, $match)) {
    verify_csrf();
    $user = require_user();
    $mission = mission_for_user((int)$match[1], $user);
    if (!in_array($mission['status'], ['ready_for_loading','edge_accepted'], true)) {
        flash('warning', 'Запуск недоступен в текущем состоянии.');
        redirect_to('/missions/' . $mission['id']);
    }
    $pdo->beginTransaction();
    try {
        $pdo->prepare('UPDATE missions SET status="start_requested" WHERE id=?')->execute([(int)$mission['id']]);
        create_command($mission, 'start_mission', ['schema_version' => '1.0', 'mission_id' => $mission['mission_uid']]);
        add_event((int)$mission['id'], 'LOADING_CONFIRMED', 'cloud', ['operator_id' => (int)$user['id']]);
        $pdo->commit();
        flash('success', 'Команда запуска поставлена в очередь.');
    } catch (Throwable $e) {
        if ($pdo->inTransaction()) $pdo->rollBack();
        flash('danger', 'Ошибка запуска: ' . $e->getMessage());
    }
    redirect_to('/missions/' . $mission['id']);
}

if ($method === 'POST' && preg_match('#^/missions/(\d+)/cancel$#', $path, $match)) {
    verify_csrf();
    $user = require_user();
    $mission = mission_for_user((int)$match[1], $user);
    if (!in_array($mission['status'], ['completed','cancelled'], true)) {
        $pdo->beginTransaction();
        try {
            $pdo->prepare('UPDATE missions SET status="cancelled" WHERE id=?')->execute([(int)$mission['id']]);
            create_command($mission, 'cancel_mission', ['schema_version' => '1.0', 'mission_id' => $mission['mission_uid']]);
            add_event((int)$mission['id'], 'CANCEL_REQUESTED', 'cloud', ['operator_id' => (int)$user['id']]);
            $pdo->commit();
            flash('success', 'Заказ отменён. Команда будет передана Edge.');
        } catch (Throwable $e) {
            if ($pdo->inTransaction()) $pdo->rollBack();
            flash('danger', 'Ошибка отмены: ' . $e->getMessage());
        }
    }
    redirect_to('/missions/' . $mission['id']);
}

